# =========================
# Application
# =========================

APP_NAME=CRM-Copilot
APP_ENV=development
DEBUG=true


# =========================
# Database
# =========================

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/crm_copilot


# =========================
# JWT Authentication
# =========================

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

JWT_ISSUER=crm-copilot
JWT_AUDIENCE=crm-copilot-api

ACCESS_TOKEN_EXPIRE_MINUTES=15

# Spec default can be 30 days
REFRESH_TOKEN_TTL_SECONDS=2592000


# =========================
# AI Providers
# =========================

# Which provider the app builds. Only these two are implemented; any other
# value now fails loudly at startup rather than returning None and surfacing
# much later as an unrelated-looking error.
LLM_PROVIDER=openrouter        # mock | openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Guardrails. Note the prefix split: GUARDRAILS_* are provider-level switches,
# GUARDRAIL_* are per-rail switches. Reading the wrong one silently does
# nothing, which is how the kill switch came to be inert.
GUARDRAILS_ENABLED=true
GUARDRAILS_PROVIDER=nemo
GUARDRAIL_INPUT_ENABLED=true
GUARDRAIL_OUTPUT_ENABLED=true

# Redis connection, required by app/core/redis_client.py.
REDIS_URL=
